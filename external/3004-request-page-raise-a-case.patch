+    {{#if settings.cp_support_phone}}
+      <p class="cp-request-alt">{{settings.cp_sev1_alt_text}} <a class="cp-phone" href="tel:{{settings.cp_support_phone}}">{{settings.cp_support_phone}}</a></p>
