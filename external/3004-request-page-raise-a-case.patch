+{{!-- A slim version of the home page hero, so the journey does not drop
+      character on the second click. Deliberately short: this is a task page,
+      and the form has to stay visible without scrolling.
+
+      The band's contents and the form below sit in the same .cp-column, so
+      they are centred together and share one left edge at every width. On a
+      narrow screen the column simply fills the container. --}}
+<section class="cp-page-head{{#if settings.homepage_background_image}} cp-page-head-has-image{{/if}}">
+  <div class="container cp-page-head-inner">
+    <div class="cp-column">
+      {{!-- Our own trail rather than {{breadcrumbs}}. Zendesk's helper builds
+            the last crumb from the page's system name, which is "Submit a
+            request" and cannot be reworded from a theme. This reads from the
+            same setting as the heading and the nav, so the three cannot
+            drift apart. --}}
+      <nav class="cp-crumbs" aria-label="Breadcrumb">
+        <ol>
+          <li>{{#link 'help_center'}}{{help_center.name}}{{/link}}</li>
+          <li aria-current="page">{{#if settings.cp_request_heading}}{{settings.cp_request_heading}}{{else}}{{t 'submit_a_request'}}{{/if}}</li>
+        </ol>
+      </nav>
+
+      {{!-- "Submit a request" is a Zendesk system string rather than one of
+            the theme's own translation keys, which is why setting the ticket
+            form's title never changed it. The template is ours, so the
+            heading comes from a theme setting and falls back to it. --}}
+      <h1 class="cp-page-head-title">
+        {{#if settings.cp_request_heading}}{{settings.cp_request_heading}}{{else}}{{t 'submit_a_request'}}{{/if}}
+      </h1>
+
+      {{#if settings.cp_request_intro}}
+        <p class="cp-page-head-intro">{{settings.cp_request_intro}}</p>
+      {{/if}}
     </div>
   </div>
+</section>
 
